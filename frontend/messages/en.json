  "about": {
    "title": "About AMANTRA",
    "mission": {
      "title": "Our Mission",
      "description": "To provide digital muamalah infrastructure that guarantees fund security, process fairness, and rights continuity across generations."
    },
    "principles": {
      "title": "Core Principles",
      "amanah": {
        "title": "Amanah (Trust)",
        "description": "Entrusted funds are sacred trusts that must never be misused."
      },
      "adl": {
        "title": "'Adl (Justice)",
        "description": "Every decision must be fair to all parties without discrimination."
      },
      "hisbah": {
        "title": "Hisbah (Oversight)",
        "description": "No power without oversight, no decision without accountability."
      },
      "shura": {
        "title": "Shura (Consultation)",
        "description": "Important decisions are made through multisig consensus, not unilateral action."
      },
      "masuliyyah": {
        "title": "Mas'uliyyah (Accountability)",
        "description": "Every action is recorded and auditable for accountability."
      },
      "rahmah": {
        "title": "Rahmah (Mercy)",
        "description": "The system is designed to facilitate, not burden users."
      }
    }
  },
  "howItWorks": {
    "title": "How AMANTRA Works",
    "steps": {
      "create": {
        "title": "1. Create Contract",
        "description": "Buyer and seller agree on clear contract terms, including amount, goods/services description, and deadline."
      },
      "fund": {
        "title": "2. Escrow Funding",
        "description": "Buyer sends funds to bank escrow account. Funds are held safely until transaction completes."
      },
      "verify": {
        "title": "3. Verification",
        "description": "After goods/services received, buyer confirms or files a dispute if there are issues."
      },
      "settle": {
        "title": "4. Settlement",
        "description": "Funds are released to seller if all goes well, or refunded if cancelled."
      },
      "dispute": {
        "title": "5. Dispute Resolution",
        "description": "If disputed, the Arbitration Council reviews evidence and issues a fair decision."
      }
    }
  },
