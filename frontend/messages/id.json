      },
      "masuliyyah": {
        "title": "Mas'uliyyah (Akuntabilitas)",
        "description": "Setiap tindakan tercatat dan dapat diaudit untuk pertanggungjawaban."
      },
      "rahmah": {
        "title": "Rahmah (Kasih Sayang)",
        "description": "Sistem dirancang untuk memudahkan, bukan menyulitkan pengguna."
      }
    }
  },
  "howItWorks": {
    "title": "Cara Kerja AMANTRA",
    "steps": {
      "create": {
        "title": "1. Buat Akad",
        "description": "Pembeli dan penjual menyepakati syarat akad dengan jelas, termasuk jumlah, deskripsi barang/jasa, dan tenggat waktu."
      },
      "fund": {
        "title": "2. Dana Escrow",
        "description": "Pembeli mengirim dana ke rekening escrow bank. Dana dijaga aman hingga transaksi selesai."
      },
      "verify": {
        "title": "3. Verifikasi",
        "description": "Setelah barang/jasa diterima, pembeli mengkonfirmasi atau mengajukan sengketa jika ada masalah."
      },
      "settle": {
        "title": "4. Penyelesaian",
        "description": "Dana dilepaskan ke penjual jika semua berjalan baik, atau dikembalikan jika terjadi pembatalan."
      },
      "dispute": {
        "title": "5. Penyelesaian Sengketa",
        "description": "Jika ada sengketa, Majelis Arbitrase akan meninjau bukti dan memberikan keputusan yang adil."
      }
    }
