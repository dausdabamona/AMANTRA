# ===========================================
# AMANTRA Environment Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/amantra
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (for caching and job queue)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Blockchain (L2 - e.g., Polygon, Arbitrum)
BLOCKCHAIN_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
BLOCKCHAIN_CHAIN_ID=137
CONTRACT_ADDRESS=0x...

# Key Management (KMS/HSM)
KMS_PROVIDER=aws
AWS_KMS_KEY_ID=your-kms-key-id
AWS_REGION=ap-southeast-1

# QRIS Payment Gateway
QRIS_API_URL=https://api.payment-gateway.id
QRIS_MERCHANT_ID=your-merchant-id
QRIS_API_KEY=your-api-key
QRIS_WEBHOOK_SECRET=your-webhook-secret

# Bank Escrow API
BANK_API_URL=https://api.bank.co.id
BANK_API_KEY=your-bank-api-key
BANK_ESCROW_ACCOUNT=1234567890
BANK_WEBHOOK_SECRET=your-bank-webhook-secret

# Audit & Logging
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Reconciliation
RECONCILIATION_CRON=0 2 * * *
